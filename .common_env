unsetopt correct_all

# Initialize the completion system. Skip the security check when the
# dump file was rebuilt within the last 24h (saves ~150ms per shell).
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
	compinit
else
	compinit -C
fi

# Case-insensitive matching: lowercase matches uppercase
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# Persist history across sessions. zsh defaults to no HISTFILE and
# SAVEHIST=0, so without this nothing is ever written to disk.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

setopt append_history          # merge into the file instead of overwriting it
setopt inc_append_history      # write each command as it runs, so a dropped
                               # SSH session doesn't take its history with it
setopt extended_history        # record timestamp and duration per entry
setopt hist_expire_dups_first  # drop duplicates first once SAVEHIST is hit
setopt hist_ignore_dups        # skip a command identical to the one before it
setopt hist_ignore_space       # skip commands typed with a leading space
setopt hist_reduce_blanks      # normalize whitespace before saving
setopt hist_verify             # expand !! onto the line rather than running it

# Up/Down arrow searches history for entries starting with the current
# input prefix, then moves cursor to end of line. Bind both terminfo
# (application keypad mode) and the literal CSI/SS3 sequences so this
# works under tmux, Ghostty, Terminal.app, etc.
autoload -Uz history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey "$terminfo[kcuu1]" history-beginning-search-backward-end
bindkey "$terminfo[kcud1]" history-beginning-search-forward-end
bindkey "^[[A" history-beginning-search-backward-end
bindkey "^[[B" history-beginning-search-forward-end

## GENERAL
if command -v lsd >/dev/null 2>&1; then
	alias ll="lsd -la"
elif ls --color=auto / >/dev/null 2>&1; then
	alias ll="ls -la --color=auto"   # GNU coreutils
else
	alias ll="ls -laG"               # BSD/macOS
fi

alias ..="cd ../"
alias ...="cd ../../"
alias ....="cd ../../../"

# Make a directory and immediately cd into it.
mkcd() {
	mkdir -p "$1" && cd "$1"
}

# cd to the current git repo's top-level.
cdr() {
	local root
	root=$(git rev-parse --show-toplevel 2>/dev/null) || {
		echo "cdr: not a git repo" >&2
		return 1
	}
	cd "$root"
}

# cd up N levels (default 1). Generalises ../../...
up() {
	local n=${1:-1}
	local p=""
	local i
	for ((i = 0; i < n; i++)); do
		p="../$p"
	done
	cd "$p"
}

## ZOXIDE (jump to frecent dirs; zoxide init lives in .zshrc)
alias j='z'
alias s='zoxide add'
alias d='zoxide remove'
alias p='zoxide query -l'

## EDITOR
# Resolve an editor once, preferring a GUI editor (codium, then code) with
# --wait so Git blocks until the file is closed; fall back to a terminal editor
# on headless hosts (those already block until you exit). Set before the q
# alias below so it reuses the resolved value.
for _ed in codium code nvim vim nano; do
	if command -v "$_ed" >/dev/null 2>&1; then
		case "$_ed" in
			codium | code) export EDITOR="$_ed --wait" ;;
			*)             export EDITOR="$_ed" ;;
		esac
		break
	fi
done
unset _ed

# q — open in the resolved editor and wait for it to close.
alias q="$EDITOR"

## GIT ALIASES
alias g="git"
alias gd="g diff"
alias gds="g diff --staged"
alias ga="g add"
alias gl="g pull"
alias gm="g merge"
alias gb="g branch"
alias gbsu="gb --set-upstream-to"
alias gst="g status"
alias gco="g checkout"
alias gco-="g checkout -"
alias gdq="gd | q -"
alias gma="git commit -a -m"
alias gcb="gco -b"
alias gcl="g clone"
alias gc="g commit"
alias gca="g commit -a"
alias gam="g commit -a --amend"
alias gane="g commit --amend --no-edit"
alias gt="g tag"
alias gta="gt -a"
alias gp="g push"
alias gpo="gp origin"
alias gpt="gp --tags"

### Git Worktrees
alias gw="g worktree"
alias gwa="gw add"
alias gwl="gw list"
alias gwlo="gw lock"
alias gwm="gw move"
alias gwp="gw prune"
alias gwrm="gw remove"
alias gwr="gw repair"
alias gwu="gw unlock"

## PIPE ALIASES
alias -g L='|less'
alias -g G='|rg'
alias -g T='|tail'
alias -g H='|head'
alias -g W='|wc -l'
alias -g S='|sort'

## SHELL HYGIENE
alias reload='exec zsh -l'
alias path='echo $PATH | tr ":" "\n" | nl'

## MISC ALIASES
alias code.="code ."
alias t="lstr"

## MISSPELLED COMMAND ALIASES
alias yarm='yarn'
alias gkl='git pull'

## RAINBOW / BANNER ALIASES (figlet + lolcat)
# Only define if the tools are installed.
if command -v lolcat >/dev/null 2>&1; then
	alias lol='lolcat'                                                    # cmd | lol
	alias lola='lolcat -a -d 2'                                           # animated rainbow
	alias glog='git log --oneline --decorate --graph --all | lolcat'
	alias llr='ls -lah | lolcat'
fi

if command -v figlet >/dev/null 2>&1 && command -v lolcat >/dev/null 2>&1; then
	# Rainbow ASCII text in three sizes, ordered small -> large:
	label() { figlet -f small "$@" | lolcat; }   # inline sub-heading
	title() { figlet -f shadow "$@" | lolcat; }  # formal section title
	hero()  { figlet -f slant "$@" | lolcat; }   # flagship banner
	alias win='figlet -f shadow WIN | lolcat'
	alias nope='figlet -f slant NOPE | lolcat'
	alias morning='figlet -f slant "Good Morning, Kevin" | lolcat'
fi

# Backwards-compat aliases for the old function names; real scripts in bin/.
alias killPort='killport'
alias updateDotfiles='dotfiles-update'

# Extract any common archive type by sniffing the extension.
extract() {
	if [[ -z "${1:-}" ]]; then
		echo "usage: extract <archive>" >&2
		return 2
	fi
	if [[ ! -f "$1" ]]; then
		echo "extract: $1 not a file" >&2
		return 1
	fi
	case "$1" in
		*.tar.gz | *.tgz)    tar -xzf "$1" ;;
		*.tar.bz2 | *.tbz2)  tar -xjf "$1" ;;
		*.tar.xz | *.txz)    tar -xJf "$1" ;;
		*.tar.zst | *.tzst)  tar --zstd -xf "$1" ;;
		*.tar)               tar -xf "$1" ;;
		*.gz)                gunzip -k "$1" ;;
		*.bz2)               bunzip2 -k "$1" ;;
		*.xz)                unxz -k "$1" ;;
		*.zip)               unzip "$1" ;;
		*.7z)                7z x "$1" ;;
		*.rar)               unrar x "$1" ;;
		*) echo "extract: don't know how to handle $1" >&2; return 1 ;;
	esac
}

sortSize() {
	du -sh ./* | sort -h
}

case "$(uname -s)" in
	Darwin) [[ -r "$HOME/.macos_env" ]] && source "$HOME/.macos_env" ;;
	Linux)  [[ -r "$HOME/.linux_env" ]] && source "$HOME/.linux_env" ;;
esac

# Per-machine values (gitignored). See .zshrc.local.example for the template.
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

