#!/bin/zsh

unsetopt correct_all
setopt no_aliases

setopt aliases

# Initialize the completion system
autoload -Uz compinit && compinit

# Case-insensitive matching: lowercase matches uppercase
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

## OS
alias f="open"

## GENERAL
if command -v lsd >/dev/null 2>&1; then
	alias ll="lsd -la"
else
	alias ll="ls -la --color"
fi

alias ..="cd ../"
alias ...="cd ../../"
alias ....="cd ../../../"

## EDITOR
alias q="code -w"

## GIT ALIASES
alias g="git"
alias gd="g diff"
alias ga="g add"
alias gl="g pull"
alias gm="g merge"
alias gb="g branch"
alias gbsu="gb --set-upstream-to"
alias gst="g status"
alias gco="g checkout"
alias gdq="gd | q -"
alias gma="git commit -a -m"
alias gcb="gco -b"
alias gcl="g clone"
alias gam="g commit -a --amend"
alias gt="g tag"
alias gta="gt -a"
alias gp="g push"
alias gpo="gp origin"
alias gpt="gp --tags"

## PIPE ALIASES
alias -g L='|less'
alias -g G='|ag'
alias -g T='|tail'
alias -g H='|head'
alias -g W='|wc -l'
alias -g S='|sort'

## MISC ALIASES
alias code.="code ."

## MISSPELLED COMMAND ALIASES
alias yarm='yarn'
alias gkl='git pull'

## RAINBOW / BANNER ALIASES (figlet + lolcat)
# Only define if the tools are installed.
if command -v lolcat >/dev/null 2>&1; then
	alias lol='lolcat'                                                    # cmd | lol
	alias lola='lolcat -a -d 2'                                           # animated rainbow
	alias glog='git log --oneline --decorate --graph --all | lolcat'
	alias llr='ls -lah | lolcat'
fi

if command -v figlet >/dev/null 2>&1 && command -v lolcat >/dev/null 2>&1; then
	# Rainbow ASCII text in three sizes, ordered small -> large:
	label() { figlet -f small "$@" | lolcat; }   # inline sub-heading
	title() { figlet -f shadow "$@" | lolcat; }  # formal section title
	hero()  { figlet -f slant "$@" | lolcat; }   # flagship banner
	alias win='figlet -f shadow WIN | lolcat'
	alias nope='figlet -f slant NOPE | lolcat'
	alias morning='figlet -f slant "Good Morning, Kevin" | lolcat'
fi

function killPort {
	sudo lsof -t -i tcp:$1 | while read pid; do kill -9 $pid; done
	if (( $? == 0 )); then; echo 'Killed'; else; echo "Can not find process at port $1"; fi
}

# Pull latest dotfiles. Override with DOTFILES_DIR (default: ~/.dotfiles).
function updateDotfiles {
	local dir="${DOTFILES_DIR:-$HOME/.dotfiles}"
	if [[ ! -d "$dir" ]]; then
		echo "updateDotfiles: directory not found: $dir" >&2
		return 1
	fi
	(
		cd "$dir" && git pull
	)
}

export EDITOR="code"

case "$(uname -s)" in
	Darwin) [[ -r "$HOME/.macos_env" ]] && source "$HOME/.macos_env" ;;
	Linux)  [[ -r "$HOME/.linux_env" ]] && source "$HOME/.linux_env" ;;
esac

