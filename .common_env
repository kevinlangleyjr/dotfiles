unsetopt correct_all
setopt no_aliases

setopt aliases

## OS
alias f="open"

## GENERAL
alias ll="ls -la"

## EDITOR
alias q="code -w"

## GIT ALIASES
alias g="git"
alias gd="g diff"
alias ga="g add"
alias gl="g pull"
alias gm="g merge"
alias gb="g branch"
alias gbsu="gb --set-upstream-to"
alias gst="g status"
alias gco="g checkout"
alias gdq="gd | q -"
alias gma="git commit -a -m"
alias gcb="gco -b"
alias gcl="g clone"
alias gam="g commit -a --amend"
alias gt="g tag"
alias gta="gt -a"
alias gp="g push"
alias gpo="gp origin"
alias gpt="gp --tags"

## PIPE ALIASES
alias -g L='|less'
alias -g G='|ag'
alias -g T='|tail'
alias -g H='|head'
alias -g W='|wc -l'
alias -g S='|sort'

## MISC ALIASES
alias code.="code ."

## MISSPELLED COMMAND ALIASES
alias yarm='yarn'
alias gkl='git pull'

function killPort {
	sudo lsof -t -i tcp:$1 | while read pid; do kill -9 $pid; done
	if (( $? == 0 )); then; echo 'Killed'; else; echo "Can not find process at port $1"; fi
}

export EDITOR="code"

case "$(uname -s)" in
	Darwin) [[ -r "$HOME/.macos_env" ]] && source "$HOME/.macos_env" ;;
	Linux)  [[ -r "$HOME/.linux_env" ]] && source "$HOME/.linux_env" ;;
esac

