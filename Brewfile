# Tools the shell config expects to be available.
# Apply with: brew bundle --file=Brewfile
# install.sh runs this automatically on macOS unless --no-bootstrap is passed.

brew "oh-my-posh"
brew "zoxide"
brew "fastfetch"
brew "lsd"
brew "lstr" # backs the `t` alias
brew "lolcat"
brew "figlet"
brew "ripgrep"
brew "git-delta"
brew "direnv"
brew "neovim" # backs `vi`; Linux gets it from the official tarball in install.sh
brew "bat"
brew "fzf"
brew "jq" # JSON parsing for statusline.sh and the claude-skills CLIs
brew "yq"
brew "gh"
brew "glab"
brew "shellcheck" # shell linter used by CI; handy for local script checks
