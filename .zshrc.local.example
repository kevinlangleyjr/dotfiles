# Per-machine shell config (gitignored).
#
# Copy this file to ~/.zshrc.local and fill in machine-specific values.
# Sourced from .common_env after the OS env file, so anything set here
# overrides cross-platform and per-OS defaults.
#
#   cp .zshrc.local.example ~/.zshrc.local

# 1Password Environment the Claude skills read (TickTick, Oura, Fitbit, EasyPost,
# GitLab tokens). In the 1Password app: Developer > View Environments > Manage
# environment > Copy environment ID. Read via `op-sa claude-skills`, whose token
# lives in ~/.config/claude-skills/op-token.
# export CLAUDE_1P_DEV_ENV_ID=""

# Any other per-machine env, aliases, or PATH bits go here.
