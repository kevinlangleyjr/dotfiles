# 1Password (macOS): sign SSH-format commits via op-ssh-sign.
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[user]
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIA1/oHj8TSKKVX8EadWZnZdA/3weBRMTXOLaLOkgMk0O
[commit]
	gpgsign = true
[tag]
	gpgsign = true
