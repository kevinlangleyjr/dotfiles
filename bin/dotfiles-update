#!/usr/bin/env bash
# Pull latest dotfiles. Override location with DOTFILES_DIR (default: ~/.dotfiles).
set -euo pipefail

dir="${DOTFILES_DIR:-$HOME/.dotfiles}"

if [[ ! -d "$dir" ]]; then
	echo "dotfiles-update: directory not found: $dir" >&2
	exit 1
fi

cd "$dir"
git pull

# install.sh clones its sibling repos as independent checkouts, so pulling
# dotfiles leaves them behind. The desktop one changes often enough to be worth
# pulling here; the theme repos are effectively static.
desktop="${ANTHRACITE_DIR:-$HOME/.anthracite-desktop}"
if [[ -d "$desktop/.git" ]]; then
	echo "dotfiles-update: pulling anthracite-desktop..." >&2
	git -C "$desktop" pull
fi
