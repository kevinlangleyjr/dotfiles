[init]
	defaultBranch = main

[user]
	name = Kevin Langley Jr.
	email = me@kevinlangleyjr.dev
	signingKey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPRoiFWS1boIQpfZVIWfBwHLdwPqll48l5DA4caovw7R

[commit]
	gpgSign = true

[gpg]
	program = /usr/local/bin/gpg
	format = ssh

# gpg.ssh.program lives in OS-specific includes below — 1Password's
# op-ssh-sign binary path differs per platform.

[core]
	autocrlf = input
	whitespace = fix,space-before-tab,tab-in-indent,trailing-space
	editor = code --wait --new-window
	excludesFile = ~/.gitignore_global
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true

[apply]
	whitespace = fix

[alias]
	br = branch
	ci = commit
	co = checkout
	df = diff
	g = grep -I
	lg = log -p
	pp = !"echo 'Pull'; git pull; echo 'Push'; git push"
	rb = rbranch
	rv = review
	st = status

[color]
	ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[merge]
	log = true
	tool = vscode
	conflictStyle = zdiff3

[mergetool "vscode"]
	cmd = code --wait $MERGED

[diff]
	tool = vscode
	colorMoved = default

[fetch]
	prune = true

[log]
	date = iso

[push]
	default = current
	autoSetupRemote = true

[tag]
	forceSignAnnotated = false

[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE

[rerere]
	enabled = 1

[filter "lfs"]
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
	required = true

# --- URL rewrites (short aliases & HTTPS → SSH) ---

[url "git@github.com:"]
	insteadOf = gh:
	pushInsteadOf = github:
	pushInsteadOf = git://github.com/

[url "git://github.com/"]
	insteadOf = github:

[url "ssh://git@github.com"]
	insteadOf = https://github.com

[url "git@gist.github.com:"]
	insteadOf = gst:
	pushInsteadOf = gist:
	pushInsteadOf = git://gist.github.com/

[url "git://gist.github.com/"]
	insteadOf = gist:

[url "git@gitlab.1password.io:"]
	insteadOf = https://gitlab.1password.io/

[url "ssh://git@ssh.gitlab.1password.io:2227"]
	insteadOf = https://gitlab.1password.io

[url "git@github-enterprise:agilebits-inc/"]
	insteadOf = https://github.com/agilebits-inc/

[url "git@github-enterprise:agilebits-inc/"]
	insteadOf = git@github.com:agilebits-inc/

[includeIf "gitdir:~/Development/1P/"]
	path = ~/.gitconfig-agilebits

[includeIf "gitdir:~/go/src/go.1password.io/"]
	path = ~/.gitconfig-agilebits

# --- OS-specific overrides (e.g. 1Password op-ssh-sign path) ---

[includeIf "gitdir:/Users/"]
	path = ~/.gitconfig-os-macos

[includeIf "gitdir:/home/"]
	path = ~/.gitconfig-os-linux
