[init]
	defaultBranch = main

[user]
	name = Kevin Langley Jr.
	email = me@kevinlangleyjr.dev

# Commit signing is configured per-machine in ~/.gitconfig-os, which install.sh
# links to the profile that fits this host (git can't branch on OS/host itself):
#   .gitconfig-os-macos         → 1Password op-ssh-sign (macOS)
#   .gitconfig-os-linux         → 1Password op-ssh-sign (Linux desktop/laptop)
#   .gitconfig-os-linux-server  → native ssh-keygen signer (no 1Password)
# Machine-specific overrides go in ~/.gitconfig.local (untracked; see below).

[core]
	autocrlf = input
	whitespace = fix,space-before-tab,tab-in-indent,trailing-space
	excludesFile = ~/.gitignore_global
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true

[apply]
	whitespace = fix

[alias]
	br = branch
	ci = commit
	co = checkout
	df = diff
	g = grep -I
	lg = log -p
	pp = !"echo 'Pull'; git pull; echo 'Push'; git push"
	rb = rbranch
	rv = review
	st = status

[color]
	ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[merge]
	log = true
	conflictStyle = zdiff3

[diff]
	tool = delta
	colorMoved = default

[fetch]
	prune = true

[log]
	date = iso

[push]
	default = current
	autoSetupRemote = true

[tag]
	forceSignAnnotated = false

[difftool "codium"]
	cmd = codium --wait --diff "$LOCAL" "$REMOTE"

[rerere]
	enabled = 1

[filter "lfs"]
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
	required = true

# --- URL rewrites (short aliases & HTTPS → SSH) ---

[url "git@github.com:"]
	insteadOf = gh:
	pushInsteadOf = github:
	pushInsteadOf = git://github.com/

[url "git://github.com/"]
	insteadOf = github:

[url "ssh://git@github.com"]
	insteadOf = https://github.com

[url "git@gist.github.com:"]
	insteadOf = gst:
	pushInsteadOf = gist:
	pushInsteadOf = git://gist.github.com/

[url "git://gist.github.com/"]
	insteadOf = gist:

[url "git@gitlab.1password.io:"]
	insteadOf = https://gitlab.1password.io/

[url "ssh://git@ssh.gitlab.1password.io:2227"]
	insteadOf = https://gitlab.1password.io

[url "git@github-enterprise:agilebits-inc/"]
	insteadOf = https://github.com/agilebits-inc/

[url "git@github-enterprise:agilebits-inc/"]
	insteadOf = git@github.com:agilebits-inc/

[includeIf "gitdir:~/Development/1P/"]
	path = ~/.gitconfig-agilebits

[includeIf "gitdir:~/go/src/go.1password.io/"]
	path = ~/.gitconfig-agilebits

# --- Per-machine signing profile (linked by install.sh) + local overrides ---
# A missing include path is silently ignored, so ~/.gitconfig.local is optional
# and, being last, wins over the profile above it.

[include]
	path = ~/.gitconfig-os

[include]
	path = ~/.gitconfig.local

[include]
	path = /home/kevin/.config/delta-slatewave/slatewave.gitconfig
